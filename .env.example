# LLM API（仅在后端真实接入翻译模型时配置）
# 必须使用可信的 HTTPS 服务；本地开发服务除外
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
# 仅可信隔离网络需要连接明文远程 LLM 时才显式开启
DOCWEAVE_ALLOW_INSECURE_LLM_HTTP=false

# MinerU 服务连接
MINERU_HOST=127.0.0.1
MINERU_PORT=8000
MINERU_BACKEND=pipeline

# Docker Compose 对外端口
DOCWEAVE_BIND_ADDRESS=127.0.0.1
DOCWEAVE_HTTP_PORT=18080

# 任务数据库、上传文件和结果文件持久化目录
DOCWEAVE_DATA_DIR=./data

# 远程解析与翻译超时（秒）
MINERU_TIMEOUT_SECONDS=900
LLM_TIMEOUT_SECONDS=300

# 后端并发任务数，默认与前端批量上传并发数保持一致
DOCWEAVE_WORKERS=4

# 单个文档内部的大模型批次并发数
LLM_BATCH_WORKERS=3
LLM_VISION_WORKERS=2
LLM_QUALITY_RETRIES=2
LLM_LAYOUT_REPAIR_RETRIES=2
LLM_VISUAL_QUALITY_RETRIES=4
LLM_HTTP_RETRIES=2

# 自动质检：全部页面渲染检查；任何阻断问题进入 needs_review
DOCWEAVE_FULL_PAGE_VISUAL_REVIEW=true
